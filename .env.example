# PostgreSQL/PostGIS
POSTGRES_USER=geokz
POSTGRES_PASSWORD=change_me_for_real_use
POSTGRES_DB=geokz
POSTGRES_PORT=5432

# GeoKZ API
GEOKZ_APP_NAME=GeoKZ API
GEOKZ_ENVIRONMENT=development
GEOKZ_DEBUG=true
GEOKZ_API_PREFIX=/api/v1
GEOKZ_DATABASE_URL=postgresql+asyncpg://geokz:change_me_for_real_use@localhost:5432/geokz
GEOKZ_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
GEOKZ_SQL_ECHO=false

# Authentication
# Opaque bearer sessions are stored in PostgreSQL only as SHA-256 token hashes.
GEOKZ_AUTH_SESSION_HOURS=12

# External data integrations
# Получается пользователем в кабинете разработчика data.egov.kz.
# GeoKZ работает и без этого ключа; он нужен только для синхронизации eGov Open Data.
GEOKZ_EGOV_API_KEY=
GEOKZ_EXTERNAL_HTTP_TIMEOUT_SECONDS=30

# Dedicated external synchronization scheduler.
# Scheduler runs as a separate process/service, not inside FastAPI workers.
GEOKZ_EXTERNAL_SCHEDULER_POLL_SECONDS=300
GEOKZ_EXTERNAL_SYNC_FAILURE_RETRY_HOURS=6
GEOKZ_EXTERNAL_SYNC_RUNNING_TIMEOUT_HOURS=6
