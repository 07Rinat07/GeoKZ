; Заготовка. Сейчас не собирается, потому что desktop-клиент ещё не создан.
#define MyAppName "GeoKZ"
#define MyAppVersion "0.1.0"
#define MyAppPublisher "GeoKZ"
#define MyAppExeName "GeoKZ.exe"

[Setup]
AppId={{9E95E168-BC78-4BE3-B66E-2B7A49D9E050}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
DefaultDirName={autopf}\GeoKZ
DefaultGroupName=GeoKZ
OutputBaseFilename=GeoKZ-Setup-{#MyAppVersion}
Compression=lzma2
SolidCompression=yes
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
WizardStyle=modern

[Files]
Source: "..\..\dist\GeoKZ\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{autoprograms}\GeoKZ"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\GeoKZ"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Tasks]
Name: "desktopicon"; Description: "Создать ярлык на рабочем столе"; GroupDescription: "Дополнительные значки:"

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "Запустить GeoKZ"; Flags: nowait postinstall skipifsilent
